{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Npgsql": "Warning",
        "Serilog": "Warning"
      }
    }
  },
  "ImageCleaner": {
    "Interval": "00:05:00",
    "MaxDegreeOfParallelism": 8
  },
  "Parameters": {
    "BEARER_EXP_DAYS": 10,
    "BEARER_REFRESH_EXP_DAYS": 2,
    "BEARER_AUDIENCE": "com.coollbreackerz",
    "BEARER_ISSUE": "Ralber"
  },
  "ValidationConfiguration": {
    "PasswordLength": 8,
    "FileTypes": [ ".png", ".jpg", ".jpeg" ],
    "ValidFileMBSize": 20
  }
}