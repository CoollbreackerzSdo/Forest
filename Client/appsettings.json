{
  "ReverseProxy": {
    "Routes": {
      "api-auth": {
        "ClusterId": "forest-api",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "api-users": {
        "ClusterId": "forest-api",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "api-img": {
        "ClusterId": "forest-api",
        "Match": { "Path": "/img/{**catch-all}" }
      }
    },
    "Clusters": {
      "forest-api": {
        "Destinations": {
          "api": { "Address": "https://localhost:7011/" }
        }
      }
    }
  }
}
