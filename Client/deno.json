{
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": [],
    "deny": ["npm:@parcel/watcher@2.5.1"]
  },
  "tasks": {
    "css": "deno run -A npm:@tailwindcss/cli -i ./wwwroot/css/styles.css -o ./wwwroot/css/app.css",
    "css:watch": "deno run -A npm:@tailwindcss/cli -i ./wwwroot/css/styles.css -o ./wwwroot/css/app.css --watch",
    "css:min": "deno run -A npm:@tailwindcss/cli -i ./wwwroot/css/styles.css -o ./wwwroot/css/app.css --minify"
  }
}
