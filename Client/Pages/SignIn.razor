@page "/sign-in"
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav
@inject OceanService Ocean

<PageTitle>Marea · Entrar</PageTitle>

<section class="mx-auto w-full max-w-6xl px-5 pt-6 pb-8 sm:px-8 lg:pt-8">
    <div class="grid items-stretch gap-6 lg:grid-cols-[1fr_0.85fr]">

        <div class="glass reveal is-visible p-6 sm:p-7">
            <span class="eyebrow">Acceso</span>
            <h1 class="mt-6 text-4xl font-bold sm:text-5xl">Bienvenido<br /><span class="display">de vuelta</span></h1>
            <p class="muted mt-4 max-w-sm text-sm leading-relaxed">Entra con tu correo para continuar.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mt-7 flex items-start gap-3 rounded-2xl border border-red-400/25 bg-red-500/10 px-4 py-3.5 text-sm text-red-100" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 h-4 w-4 shrink-0 text-red-300">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7.5v5M12 16.2v.1" />
                    </svg>
                    <span>@error</span>
                </div>
            }

            <EditForm Model="model" OnValidSubmit="Submit" class="mt-8">
                <fieldset disabled="@loading" class="contents space-y-5">
                    <div class="field">
                        <label class="label" for="login">Correo *</label>
                        <input id="login" class="input" type="email" autocomplete="email" required placeholder="tu@correo.com"
                               @bind="model.EmailOrUserName" @bind:event="oninput" />
                    </div>

                    <div class="field">
                        <div class="flex items-center justify-between gap-3">
                            <label class="label" for="password">Contraseña *</label>
                            <button type="button" class="text-xs font-medium text-muted transition-colors hover:text-ink" @onclick="() => reveal = !reveal">
                                @(reveal ? "Ocultar" : "Mostrar")
                            </button>
                        </div>
                        <input id="password" class="input" type="@(reveal ? "text" : "password")" autocomplete="current-password" required
                               placeholder="••••••••" @bind="model.Password" @bind:event="oninput" />
                    </div>
                </fieldset>

                <button type="submit" class="btn btn-accent btn-block mt-5" disabled="@loading">
                    @if (loading)
                    {
                        <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-black/25 border-t-black/70"></span>
                        <text>Entrando…</text>
                    }
                    else
                    {
                        <text>Entrar</text>
                    }
                </button>
            </EditForm>

            <div class="hairline my-6"></div>

            <p class="text-center text-sm text-muted">
                ¿Todavía no tienes cuenta?
                <a class="font-semibold text-ink underline-offset-4 hover:underline" href="/sign-up">Crea una gratis</a>
            </p>
        </div>

        <aside class="scene-plate reveal is-visible relative hidden overflow-hidden rounded-[2rem] border border-white/10 lg:block">
            <div class="absolute inset-0 flex flex-col justify-end p-9">
                <span class="text-[0.65rem] font-semibold tracking-[0.28em] uppercase" style="color:var(--accent)">Escena @SceneLabel</span>
                <p class="mt-3 max-w-xs text-2xl leading-snug font-semibold text-white/95">
                    Cada fondo trae su propia paleta. La web se tiñe con ella.
                </p>
            </div>
        </aside>
    </div>
</section>

