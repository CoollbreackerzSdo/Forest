@page "/not-found"

<PageTitle>Marea · No encontrado</PageTitle>

<section class="mx-auto w-full max-w-2xl px-5 pt-12 pb-12 text-center sm:px-8 lg:pt-16">
    <div class="reveal is-visible">
        <p class="display text-[clamp(4rem,18vw,9rem)] font-bold leading-none">404</p>
        <h1 class="mt-6 text-3xl font-bold sm:text-4xl">Esta página se ha ido a merced</h1>
