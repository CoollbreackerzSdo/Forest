@page "/profile"
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav
@inject OceanService Ocean

<PageTitle>Marea · Perfil</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <section class="mx-auto w-full max-w-lg px-5 pt-12 pb-10 sm:px-8">
        <div class="glass reveal is-visible p-9 text-center">
            <h1 class="text-3xl font-bold">Sesión requerida</h1>
            <p class="muted mt-3 text-sm">Debes iniciar sesión para ver tu perfil.</p>
            <a class="btn btn-accent mt-7" href="/sign-in">Entrar</a>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-5xl px-5 pt-6 pb-12 sm:px-8">

        <!-- ============ cabecera tipo blog ============ -->
        <header class="reveal is-visible">
            <div class="relative">
                <div class="profile-cover relative h-40 overflow-hidden rounded-[2rem] border border-white/10 sm:h-56">
                    @if (CoverUrl is not null)
                    {
                        <img src="@CoverUrl" alt="Banner del perfil" class="absolute inset-0 h-full w-full object-cover" />
                    }
                    <div class="absolute inset-0 bg-gradient-to-t from-[#06131f]/92 via-[#06131f]/25 to-transparent"></div>

                    <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/35 px-3 py-1.5 text-[0.7rem] font-semibold tracking-wide text-white/90 backdrop-blur-md">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                        Sesión activa
                    </span>

                    <span class="absolute right-5 top-5 hidden rounded-full border border-white/10 bg-black/30 px-3 py-1.5 text-[0.68rem] font-medium tracking-wide text-white/85 backdrop-blur-md sm:inline-block">
                        Escena @SceneLabel
                    </span>
                </div>

                <!-- avatar + identidad -->
                <div class="relative z-10 -mt-12 px-4 sm:-mt-14 sm:px-7">
                    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
                        <div class="flex items-end gap-4">
                            <div class="profile-avatar shrink-0">
                                @if (AvatarUrl is not null)
                                {
                                    <img src="@AvatarUrl" alt="Foto de @Auth.UserName" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    @Initial
                                }
                            </div>
                            <div class="pb-1">
                                <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">@Auth.UserName</h1>
                                <p class="muted mt-1 text-sm">@Auth.Email</p>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-3 pb-1">
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleEditor">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <path d="M12 20h9" />
                                    <path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4z" />
                                </svg>
                                Editar perfil
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ============ editor ============ -->
        @if (editing)
        {
            <div class="glass reveal is-visible mt-7 p-6 sm:p-7">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-semibold">Editar perfil</h2>
                        <p class="muted mt-1 text-sm">Se guarda con <span class="font-mono text-xs text-ink/80">PUT users</span>.</p>
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleEditor">Cerrar</button>
                </div>

                <EditForm Model="model" OnValidSubmit="Save" class="mt-6 space-y-4">
                    <div class="grid gap-4 sm:grid-cols-3">
                        <div class="field">
                            <label class="label" for="userName">Usuario</label>
                            <input id="userName" class="input" type="text" maxlength="50" autocomplete="username" disabled="@saving"
                                   placeholder="@Auth.UserName" @bind="model.UserName" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label class="label" for="firstName">Nombre</label>
                            <input id="firstName" class="input" type="text" maxlength="100" autocomplete="given-name" disabled="@saving"
                                   placeholder="Ada" @bind="model.FirstName" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label class="label" for="lastName">Apellidos</label>
                            <input id="lastName" class="input" type="text" maxlength="100" autocomplete="family-name" disabled="@saving"
                                   placeholder="Lovelace" @bind="model.LastName" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="file-drop" for="photo">
                            <span class="file-drop-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <circle cx="8.5" cy="10" r="1.6" />
                                    <path d="M21 16l-4.5-4.5L7 21" />
                                </svg>
                            </span>
                            <span class="file-drop-text">
                                @if (photo is null)
                                {
                                    <span class="file-drop-title">Foto de perfil</span>
                                    <span class="file-drop-hint">Opcional · PNG o JPG</span>
                                }
                                else
                                {
                                    <span class="file-drop-title">@photo.Name</span>
                                    <span class="file-drop-hint">@FormatSize(photo.Size) · cambiar</span>
                                }
                            </span>
                            <InputFile id="photo" class="sr-only" accept=".png,.jpg,.jpeg" disabled="@saving" OnChange="PickPhoto" />
                        </label>

                        <label class="file-drop" for="banner">
                            <span class="file-drop-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <rect x="3" y="4" width="18" height="16" rx="3" />
                                    <path d="M3 15l4.5-4.5L12 15" />
                                    <path d="M14 15l2-2 5 5" />
                                </svg>
                            </span>
                            <span class="file-drop-text">
                                @if (banner is null)
                                {
                                    <span class="file-drop-title">Banner de portada</span>
                                    <span class="file-drop-hint">Opcional · PNG o JPG</span>
                                }
                                else
                                {
                                    <span class="file-drop-title">@banner.Name</span>
                                    <span class="file-drop-hint">@FormatSize(banner.Size) · cambiar</span>
                                }
                            </span>
                            <InputFile id="banner" class="sr-only" accept=".png,.jpg,.jpeg" disabled="@saving" OnChange="PickBanner" />
                        </label>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="flex items-start gap-3 rounded-2xl border border-red-400/25 bg-red-500/10 px-4 py-3 text-sm text-red-100" role="alert">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 h-4 w-4 shrink-0 text-red-300">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7.5v5M12 16.2v.1" />
                            </svg>
                            <span>@error</span>
                        </div>
                    }

                    @if (saved)
                    {
                        <div class="flex items-start gap-3 rounded-2xl border border-emerald-400/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100" role="status">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-300">
                                <path d="M20 6L9 17l-5-5" />
                            </svg>
                            <span>Perfil actualizado. La foto y el banner ya están guardados en el servidor.</span>
                        </div>
                    }

                    <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" class="btn btn-accent" disabled="@saving">
                            @if (saving)
                            {
                                <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-black/25 border-t-black/70"></span>
                                <text>Guardando…</text>
                            }
                            else
                            {
                                <text>Guardar cambios</text>
                            }
                        </button>
                        <p class="muted text-xs">La foto y el banner se suben al almacenamiento del servidor y se vuelven a pintar desde ahí.</p>
                    </div>
                </EditForm>
            </div>
        }

        <!-- ============ pestañas + contenido ============ -->
        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-8">
            <div class="min-w-0">
                <nav class="flex gap-6 border-b border-white/10" aria-label="Secciones del perfil">
                    @foreach (var item in Tabs)
                    {
                        <button type="button" class="profile-tab @(item == tab ? "is-active" : "")" @onclick="() => tab = item">@item</button>
                    }
                </nav>

                <div class="mt-6">
                    @switch (tab)
                    {
                        case "Publicaciones":
                            <article class="glass-soft flex flex-col items-center px-6 py-14 text-center">
                                <span class="grid h-16 w-16 place-items-center rounded-[1.4rem]"
                                      style="background:color-mix(in oklab, var(--accent) 14%, transparent);color:var(--accent)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
                                        <path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z" />
                                        <path d="M14 3v5h5" />
                                        <path d="M9 13h6M9 17h4" />
                                    </svg>
                                </span>
                                <h2 class="mt-5 text-lg font-semibold">Todavía no has publicado nada</h2>
                                <p class="muted mt-2 max-w-sm text-sm leading-relaxed">En cuanto publiques tu primera historia aparecerá aquí con su portada, su resumen y sus etiquetas.</p>
                            </article>
                            break;

                        case "Guardados":
                            <article class="glass-soft flex flex-col items-center px-6 py-14 text-center">
                                <span class="grid h-16 w-16 place-items-center rounded-[1.4rem]"
                                      style="background:color-mix(in oklab, var(--accent) 14%, transparent);color:var(--accent)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
                                        <path d="M6 4h12v17l-6-4-6 4z" />
                                    </svg>
                                </span>
                                <h2 class="mt-5 text-lg font-semibold">No has guardado nada todavía</h2>
                                <p class="muted mt-2 max-w-sm text-sm leading-relaxed">Las historias que marques para después se quedan aquí, solo para ti.</p>
                            </article>
                            break;

                        default:
                            <article class="glass-soft p-6 sm:p-7">
                                <h2 class="text-lg font-semibold">Tu cuenta</h2>
                                <p class="muted mt-2 max-w-lg text-sm leading-relaxed">
                                    La sesión viaja en una cookie <span class="font-mono text-xs text-ink/80">HttpOnly</span>: el navegador la envía
                                    solo en cada petición, sin guardar ningún token en el cliente ni mandar cabeceras de autorización.
                                </p>

                                <dl class="mt-6 grid gap-5 sm:grid-cols-2">
                                    <div>
                                        <dt class="label">Usuario</dt>
                                        <dd class="mt-1.5 text-sm">@Auth.UserName</dd>
                                    </div>
                                    <div>
                                        <dt class="label">Correo</dt>
                                        <dd class="mt-1.5 text-sm">@Auth.Email</dd>
                                    </div>
                                    <div>
                                        <dt class="label">Sesión</dt>
                                        <dd class="mt-1.5 inline-flex items-center gap-2 text-sm">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                                            Activa
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="label">Escena</dt>
                                        <dd class="mt-1.5 text-sm">@SceneLabel</dd>
                                    </div>
                                </dl>

                                <div class="hairline my-6"></div>

                                <h3 class="text-sm font-semibold">Zona de riesgo</h3>
                                <p class="muted mt-1.5 text-sm">Cerrar sesión revoca el token en el servidor y borra la cookie del navegador.</p>
                                <button type="button" class="btn btn-ghost mt-4" @onclick="Logout">Cerrar sesión</button>
                            </article>
                            break;
                    }
                </div>
            </div>

            <!-- ============ columna lateral ============ -->
            <aside class="space-y-4">
                <div class="glass-soft p-6">
                    <h3 class="text-xs font-semibold tracking-[0.18em] text-ink/70 uppercase">Tu cuenta</h3>
                    <dl class="mt-4 space-y-3 text-sm">
                        <div class="flex items-center justify-between gap-3">
                            <dt class="muted">Usuario</dt>
                            <dd class="truncate font-medium">@Auth.UserName</dd>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <dt class="muted">Correo</dt>
                            <dd class="truncate font-medium">@Auth.Email</dd>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <dt class="muted">Sesión</dt>
                            <dd class="inline-flex items-center gap-2 font-medium">
                                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                                Activa
                            </dd>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <dt class="muted">Escena</dt>
                            <dd class="truncate font-medium">@SceneLabel</dd>
                        </div>
                    </dl>
                </div>

                <div class="glass-soft p-6">
                    <h3 class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Acciones</h3>
                    <button type="button" class="btn btn-accent btn-block mt-4" @onclick="ToggleEditor">
                        Editar perfil
                    </button>
                    <a class="btn btn-ghost btn-block mt-3" href="/">Volver al inicio</a>
                    <button type="button" class="btn btn-ghost btn-block mt-3" @onclick="Logout">Cerrar sesión</button>
                </div>

                <div class="glass-soft p-6">
                    <h3 class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">Escena</h3>
                    <p class="mt-3 text-sm font-medium">@SceneLabel</p>
                    <p class="muted mt-1.5 text-xs leading-relaxed">El fondo y la paleta se sortean en cada visita y se mantienen mientras navegas.</p>
                </div>
            </aside>
        </div>
    </section>
}

