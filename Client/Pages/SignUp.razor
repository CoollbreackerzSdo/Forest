@page "/sign-up"
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav
@inject OceanService Ocean

<PageTitle>Marea · Crear cuenta</PageTitle>

<section class="mx-auto w-full max-w-6xl px-5 pt-6 pb-6 sm:px-8 lg:pt-8">
    <div class="grid items-start gap-6 lg:grid-cols-[1.05fr_0.95fr]">

        <div class="glass reveal is-visible p-5 sm:p-6">
            <span class="eyebrow">Registro</span>
            <h1 class="mt-5 text-4xl font-bold sm:text-5xl">Crea tu <span class="display">cuenta</span></h1>
            <p class="muted mt-3 max-w-md text-sm leading-relaxed">Necesitas un correo, un nombre de usuario y una contraseña segura.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mt-7 flex items-start gap-3 rounded-2xl border border-red-400/25 bg-red-500/10 px-4 py-3.5 text-sm text-red-100" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 h-4 w-4 shrink-0 text-red-300">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7.5v5M12 16.2v.1" />
                    </svg>
                    <span>@error</span>
                </div>
            }

            <EditForm Model="model" OnValidSubmit="Submit" class="mt-6">
                <fieldset disabled="@loading" class="contents space-y-4">
                    <div class="grid gap-5 sm:grid-cols-2">
                        <div class="field">
                            <label class="label" for="email">Correo *</label>
                            <input id="email" class="input" type="email" autocomplete="email" required placeholder="tu@correo.com"
                                   @bind="model.Email" @bind:event="oninput" />
                        </div>

                        <div class="field">
                            <label class="label" for="username">Usuario *</label>
                            <input id="username" class="input" type="text" autocomplete="username" required maxlength="50" placeholder="nombre de usuario"
                                   @bind="model.UserName" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="field">
                        <div class="flex items-center justify-between gap-3">
                            <label class="label" for="password">Contraseña *</label>
                            <button type="button" class="text-xs font-medium text-muted transition-colors hover:text-ink" @onclick="() => reveal = !reveal">
                                @(reveal ? "Ocultar" : "Mostrar")
                            </button>
                        </div>
                        <input id="password" class="input" type="@(reveal ? "text" : "password")" autocomplete="new-password" required
                               placeholder="Mínimo 8 caracteres" @bind="model.Password" @bind:event="oninput" />

                        <ul class="mt-3 grid gap-1.5 text-xs sm:grid-cols-2">
                            @foreach (var rule in Rules)
                            {
                                <li class="flex items-center gap-2" style="color:@(rule.Ok ? "var(--accent)" : "var(--ink-muted)")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0">
                                        @if (rule.Ok)
                                        {
                                            <path d="M20 6L9 17l-5-5" />
                                        }
                                        else
                                        {
                                            <circle cx="12" cy="12" r="8.5" opacity=".5" />
                                        }
                                    </svg>
                                    @rule.Text
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="file-drop" for="photo">
                            <span class="file-drop-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <circle cx="8.5" cy="10" r="1.6" />
                                    <path d="M21 16l-4.5-4.5L7 21" />
                                </svg>
                            </span>
                            <span class="file-drop-text">
                                @if (photo is null)
                                {
                                    <span class="file-drop-title">Foto de perfil</span>
                                    <span class="file-drop-hint">Opcional · PNG o JPG</span>
                                }
                                else
                                {
                                    <span class="file-drop-title">@photo.Name</span>
                                    <span class="file-drop-hint">@FormatSize(photo.Size) · cambiar</span>
                                }
                            </span>
                            <InputFile id="photo" class="sr-only" accept=".png,.jpg,.jpeg" OnChange="PickPhoto" />
                        </label>

                        <label class="file-drop" for="banner">
                            <span class="file-drop-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <rect x="3" y="4" width="18" height="16" rx="3" />
                                    <path d="M3 15l4.5-4.5L12 15" />
                                    <path d="M14 15l2-2 5 5" />
                                </svg>
                            </span>
                            <span class="file-drop-text">
                                @if (banner is null)
                                {
                                    <span class="file-drop-title">Banner de portada</span>
                                    <span class="file-drop-hint">Opcional · PNG o JPG</span>
                                }
                                else
                                {
                                    <span class="file-drop-title">@banner.Name</span>
                                    <span class="file-drop-hint">@FormatSize(banner.Size) · cambiar</span>
                                }
                            </span>
                            <InputFile id="banner" class="sr-only" accept=".png,.jpg,.jpeg" OnChange="PickBanner" />
                        </label>
                    </div>
                </fieldset>

                <button type="submit" class="btn btn-accent btn-block mt-4" disabled="@loading">
                    @if (loading)
                    {
                        <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-black/25 border-t-black/70"></span>
                        <text>Creando cuenta…</text>
                    }
                    else
                    {
                        <text>Crear cuenta</text>
                    }
                </button>
            </EditForm>

            <div class="hairline my-5"></div>

            <p class="text-center text-sm text-muted">
                ¿Ya tienes cuenta?
                <a class="font-semibold text-ink underline-offset-4 hover:underline" href="/sign-in">Inicia sesión</a>
            </p>
        </div>

        <aside class="glass reveal is-visible p-7 sm:p-9">
            <span class="eyebrow">Escena @SceneLabel</span>
            <div class="scene-plate relative mt-6 aspect-video w-full overflow-hidden rounded-[1.5rem]">
                <div class="absolute inset-0 flex flex-col justify-end p-6">
                    <p class="max-w-xs text-xl leading-snug font-semibold text-white/95">
                        El fondo también se dibuja mientras haces scroll.
                    </p>
                </div>
            </div>

            <ul class="mt-7 space-y-4 text-sm">
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full" style="background:color-mix(in oklab, var(--accent) 20%, transparent);color:var(--accent)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                    </span>
                    <span class="muted">El color de acento se extrae de la imagen de fondo activa.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full" style="background:color-mix(in oklab, var(--accent) 20%, transparent);color:var(--accent)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                    </span>
                    <span class="muted">La contraseña se valida con las mismas reglas que usa el servidor.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full" style="background:color-mix(in oklab, var(--accent) 20%, transparent);color:var(--accent)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                    </span>
                    <span class="muted">La sesión vive en una cookie del servidor: el navegador la envía solo.</span>
                </li>
            </ul>
        </aside>
    </div>
</section>

